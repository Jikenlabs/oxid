{
  "name": "@oxid/viewer",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/oxid-viewer.umd.js",
  "module": "./dist/oxid-viewer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/oxid-viewer.es.js",
      "require": "./dist/oxid-viewer.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && cp dist/oxid-viewer.* ../backend/static/ && cp demo-component.html ../backend/static/",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
